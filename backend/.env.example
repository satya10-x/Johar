# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database (MongoDB Atlas in production) ---
MONGODB_URI=mongodb://127.0.0.1:27017/johar

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- AI (Groq) — used for challenge analysis, duplicate detection,
#     university/industry matching, impact summaries and replication matching.
#     Never exposed to the frontend. AI features degrade gracefully without it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Media uploads (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173
